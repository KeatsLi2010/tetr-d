HOST=127.0.0.1
PORT=4180
BUILD_ID=dev
NODE_ENV=development
WS_ALLOWED_ORIGINS=http://127.0.0.1:4180
WS_ALLOWED_HOSTS=127.0.0.1:4180
WS_ALLOW_INSECURE_DEVELOPMENT=false
WS_MAX_CONNECTIONS=1024
WS_MAX_CONNECTIONS_PER_IP=64
WS_SHUTDOWN_GRACE_MS=5000
# Authoritative simulation only; snapshots are sent at a lower cadence.
MATCH_TICK_RATE_HZ=240
# Durable JSONL replays live outside immutable releases in production.
MATCH_REPLAY_DIR=data/replays
# Empty uses an ephemeral development key. Production requires a fixed 32+ byte hex or base64url secret.
SESSION_HMAC_KEY=
